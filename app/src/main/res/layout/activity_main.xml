
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">
    <!-- 添加黑色背景遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />


    <!-- PreviewView 在底层 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_marginTop="180dp"
        android:layout_marginBottom="150dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />
    <!-- 视频流显示视图 -->
    <ImageView
        android:id="@+id/stream_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="180dp"
        android:layout_marginBottom="150dp"
        android:visibility="gone"
        android:scaleType="fitCenter"/>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/topStatusCard"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_margin="8dp"
        app:cardBackgroundColor="#CC1A1A1A"
        app:cardCornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 连接状态指示 -->
            <View
                android:id="@+id/statusIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/status_disconnected"
                android:layout_marginEnd="8dp"/>

            <!-- 连接状态文本 -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="未连接"
                android:textColor="@color/white"
                android:textSize="14sp"/>

            <!-- 连接时间显示 -->
            <TextView
                android:id="@+id/timerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连接时间:00:00"
                android:textColor="@color/teal_200"
                android:textSize="14sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 语音播报切换按钮 -->
    <androidx.cardview.widget.CardView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="70dp"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="4dp">

        <ImageView
            android:id="@+id/toggle_speech_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/toggle_speech_button"
            android:gravity="center"
            android:scaleType="center"
            android:src="@drawable/ic_volume_off" />
    </androidx.cardview.widget.CardView>

    <!-- 语音播报切换按钮 -->
    <androidx.cardview.widget.CardView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|center"
        android:layout_marginTop="70dp"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="4dp">

        <ImageView
            android:id="@+id/mode_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/scan_mode_button"
            android:gravity="center"
            android:scaleType="center"
            android:src="@drawable/ic_mode_manual" />
    </androidx.cardview.widget.CardView>


    <!-- 闪光灯按钮 -->
    <androidx.cardview.widget.CardView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="4dp">

        <ImageView
            android:id="@+id/flash_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/flash_light_button"
            android:gravity="center"
            android:scaleType="center"
            android:src="@drawable/ic_flash_off" />
    </androidx.cardview.widget.CardView>

    <!-- 拍照按钮 -->
    <androidx.cardview.widget.CardView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="8dp">

        <ImageView
            android:id="@+id/capture_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/camera_button"
            android:gravity="center"
            android:scaleType="center"
            android:src="@drawable/ic_camera" />
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="64dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="4dp">

        <ImageView
            android:id="@+id/camera_switch_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/camera_switch_button"
            android:gravity="center"
            android:scaleType="center"
            android:src="@drawable/ic_camera_switch" />
    </androidx.cardview.widget.CardView>

</FrameLayout>